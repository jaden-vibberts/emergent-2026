# Required now. Copy from your Supabase project's Connect dialog / Settings.
SUPABASE_URL=
# Server-only secret key (sb_secret_...). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Required when device ingestion is implemented. Generate with openssl rand -hex 32.
DEVICE_INGEST_KEY=
# 1 = real time; 22.5 = 45 minutes compressed to 2 minutes.
# Only durations are divided by this value; vibration strength is unchanged.
TIME_SCALE=1

# Needed later for QR links and Web Push. Leave push values blank for Step 1.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
